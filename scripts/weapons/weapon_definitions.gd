const ACCENTS: Dictionary = {
    "pistol": "#41d9ee",
    "revolver": "#d9b04a",
    "smg": "#5cc26b",
    "rifle": "#c9822f",
    "shotgun": "#d4503a",
    "lmg": "#d8c64c",
    "sniper": "#9a85e6",
    "tesla": "#4fd8ff",
}

static func get_accent(weapon_id: String) -> Color:
    return Color(str(ACCENTS.get(weapon_id, "#c9822f")))

static func get_definition(weapon_id: String) -> Dictionary:
    var source: Dictionary = DEFINITIONS["rifle"]
    if DEFINITIONS.has(weapon_id):
        source = DEFINITIONS[weapon_id]
    var result: Dictionary = DEFAULTS.duplicate(true)
    for key in source.keys():
        result[key] = source[key]
    result["id"] = weapon_id if DEFINITIONS.has(weapon_id) else "rifle"
    return result

static func exists(weapon_id: String) -> bool:
    return DEFINITIONS.has(weapon_id)

static func get_price(weapon_id: String) -> int:
    return int(get_definition(weapon_id).get("price", 0))

static func get_display_name(weapon_id: String, language: String = "en") -> String:
    var def: Dictionary = get_definition(weapon_id)
    if language == "fa":
        return str(def.get("name_fa", def.get("display_name", weapon_id)))
    return str(def.get("display_name", weapon_id))

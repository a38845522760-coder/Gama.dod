var language: String = "fa"

func _ready() -> void:
    process_mode = Node.PROCESS_MODE_ALWAYS
    language = str(SettingsManager.get_setting("language", "fa"))
    SettingsManager.settings_changed.connect(_on_settings_changed)

func t(key: String) -> String:
    var entry: Variant = STRINGS.get(key)
    if entry == null:
        return key
    var table: Dictionary = entry
    return str(table.get(language, table.get("en", key)))

func is_rtl() -> bool:
    return language == "fa"

func apply_direction(control: Control) -> void:
    control.layout_direction = Control.LAYOUT_DIRECTION_RTL if is_rtl() else Control.LAYOUT_DIRECTION_LTR

func _on_settings_changed(settings: Dictionary) -> void:
    var next_language := str(settings.get("language", language))
    if next_language != language:
        language = next_language
        language_changed.emit(language)

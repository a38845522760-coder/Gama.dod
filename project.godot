; Iron Yard — Phase 3 (game modes, AI, shop)
; Built for Godot 4.4+

config_version=5

[application]

config/name="Iron Yard"
config/description="Mobile-first 3D first-person shooter."
run/main_scene="res://scenes/boot/boot.tscn"
config/icon="res://icon.svg"
config/quit_on_go_back=false
config/features=PackedStringArray("4.4")
run/max_fps=60

[autoload]

EventBus="*res://scripts/autoload/event_bus.gd"
AppState="*res://scripts/autoload/app_state.gd"
SettingsManager="*res://scripts/autoload/settings_manager.gd"
SaveManager="*res://scripts/autoload/save_manager.gd"
Loc="*res://scripts/autoload/localization.gd"
PerformanceManager="*res://scripts/systems/performance/performance_manager.gd"
ContentManager="*res://scripts/content/content_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/energy_saving/keep_screen_on=true
window/handheld/orientation=0

[input]

move_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87), Object(InputEventKey,"physical_keycode":4194320)]
}
move_backward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83), Object(InputEventKey,"physical_keycode":4194322)]
}
move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventKey,"physical_keycode":4194319)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68), Object(InputEventKey,"physical_keycode":4194321)]
}
jump={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":32)]
}
sprint={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194325)]
}
interact={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":69)]
}
crouch={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194326)]
}
fire={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":1)]
}
prone={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":90)]
}
toggle_camera={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":86)]
}
cycle_weather={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":84)]
}
reload={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":82)]
}
inspect_equipment={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":71)]
}
pause={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194305)]
}
zoom={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":2)]
}
scan={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":81)]
}

next_weapon={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":70)]
}
use_medkit={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":72)]
}
use_armor={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":74)]
}
use_ammo={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":75)]
}
open_shop={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":66)]
}
throw_grenade={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":88)]
}
place_trap={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":67)]
}

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=8
3d/default_gravity=18.0
3d/default_gravity_vector=Vector3(0, -1, 0)
3d/physics_engine="GodotPhysics3D"
common/enable_pause_aware_picking=true

[rendering]

renderer/rendering_method="mobile"
anti_aliasing/quality/msaa_3d=1
renderer/rendering_method.mobile="mobile"
textures/default_filters/use_nearest_mipmap_filter=false
textures/default_filters/anisotropic_filtering_level=3
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.035, 0.055, 0.075, 1)
